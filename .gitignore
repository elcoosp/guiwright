# Build artifacts
target/
bench-results/
*.pprof

# Editor / OS noise
.idea/
.vscode/
*.swp
.DS_Store

# Local env / credentials — never commit
.env
.env.*

# Guiwright per-test artifacts (§10/§12): failing-run screenshot artifacts
# and trace archives never belong in version control.
**/tests/screenshots/**/*.new.png
**/tests/screenshots/**/*.diff.png
target/guiwright/

# Handoff artifacts (AI Constraints): authored per delivery, never committed.
# ship.toml is the per-file commit plan; pr-body.md is the PR description.
ship.toml
.github/pr-body.md
docs/launch.md
